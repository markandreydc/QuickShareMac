{
  "sourceLanguage" : "en",
  "strings" : {
    "InvalidDeviceName" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter a device name without control characters, up to 171 UTF-8 bytes." } } } },
    "ConnectingBeforeApproval" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Opening the network connection and verifying Quick Share. A transfer request has not reached the phone yet." } } }
    },
    "LocalNetworkBlocked" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS blocked local-network access." } } }
    },
    "LocalNetworkBlockedHelp" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS denied this connection. Allow QuickShareMac in System Settings → Privacy & Security → Local Network. If already enabled, quit and reopen this signed build, then retry." } } }
    },
    "OpenNetworkSettings" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Network Settings…" } } }
    },
    "RecipientRefusedConnection" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The receiving device refused the connection." } } }
    },
    "RecipientRefusedHelp" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Quick Share on the unlocked phone and choose Receive, or retry using Connect with QR code. Keep both devices on the same Wi-Fi network." } } }
    },
    "FinishCurrentTransfer" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finish or cancel the current transfer before choosing other items." } } }
    },
    "RecipientUnavailable" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This device is no longer available, or already has a transfer in progress. Retry to find it again." } } }
    },
    "RetryChooseRecipient" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Retry to choose a recipient again, or select other items to send." } } }
